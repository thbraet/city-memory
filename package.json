{
  "name": "city-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Learn the location of every Belgian municipality.",
  "scripts": {
    "prestart": "npm run build:site",
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs 8080 .",
    "serve:dist": "node scripts/serve.mjs 8080 dist",
    "build": "npm run build:api && npm run build:site",
    "build:data": "node scripts/build-data.mjs",
    "build:api": "node scripts/build-api.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --test test/"
  },
  "devDependencies": {
    "osmtogeojson": "^3.0.0-beta.5",
    "d3-geo": "^3.1.1",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "topojson-client": "^3.1.0",
    "jsdom": "^25.0.1"
  }
}
